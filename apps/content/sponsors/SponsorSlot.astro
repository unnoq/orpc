---
// Two shapes, both injected into MDX by inject.ts:
//
//   <SponsorSlot grid />  the page's first slot — every position, sold or not.
//   <SponsorSlot />       later slots — two cells that client.ts rotates
//                         through the pool, so a page varies per view.
//
// Both render real cards on the server. The inline ones are rewritten in place
// rather than swapped in, so the markup never changes shape: no skeleton, no
// layout shift, and the cards still show without JS.
import AdCard from './AdCard.astro'
import AdvertiseCard from './AdvertiseCard.astro'
import { adSlots, soldSponsors } from './data'

interface Props {
  grid?: boolean
}

const { grid = false } = Astro.props

const INLINE_CELLS = 2

const pool = soldSponsors()
const cells = grid
  ? adSlots()
  : Array.from({ length: INLINE_CELLS }, (_, index) => ({ position: undefined, sponsor: pool[index] ?? null }))
---

<aside
  aria-label={grid ? 'Sponsors' : 'Sponsor'}
  class="my-6"
  data-sponsor-slot={grid ? undefined : ''}
>
  <p class="mb-2 font-mono text-[10px] tracking-widest text-muted-foreground uppercase">
    {grid ? 'Sponsors' : 'Sponsor'}
  </p>

  {/* One card per row on a phone, so the name and tagline keep the full width;
      two-up from `sm` on. */}
  <div class="grid grid-cols-1 gap-2 sm:grid-cols-2">
    {
      cells.map(({ position, sponsor }) => (
        sponsor
          ? <AdCard sponsor={sponsor} />
          : <AdvertiseCard position={position} />
      ))
    }
  </div>
</aside>
